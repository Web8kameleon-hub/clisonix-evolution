FROM python:3.13

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY clx_i_service.py .

RUN pip install --no-cache-dir fastapi httpx uvicorn[standard] pydantic prometheus-client

EXPOSE 8048

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8048/health || exit 1

CMD ["uvicorn", "clx_i_service:app", "--host", "0.0.0.0", "--port", "8048"]
