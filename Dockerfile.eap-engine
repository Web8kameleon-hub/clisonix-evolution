FROM python:3.13

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    LANG=C.UTF-8

RUN pip install --no-cache-dir fastapi uvicorn pydantic

COPY services/eap /app/services/eap
COPY apps/api /app/apps/api

EXPOSE 9501

CMD ["python", "-m", "uvicorn", "services.eap.main:app", "--host", "0.0.0.0", "--port", "9501"]
