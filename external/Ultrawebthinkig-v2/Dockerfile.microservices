# Ultrawebthinking v2 microservices base image
# Mirrors production-ready build while keeping runtime generic for per-service commands.
FROM node:20-alpine AS base

FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable && corepack prepare yarn@4.9.2 --activate
COPY package.json yarn.lock* .yarnrc.yml ./
COPY .yarn ./.yarn
# Force node-modules linker in container so runtime COPY of /app/node_modules is valid.
RUN yarn config set nodeLinker node-modules && yarn install --immutable --inline-builds

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Service entry scripts use CommonJS `require`; enforce CommonJS package type in the runtime image.
RUN npm pkg set type=commonjs
EXPOSE 3000
CMD ["node", "backend-server.js"]
