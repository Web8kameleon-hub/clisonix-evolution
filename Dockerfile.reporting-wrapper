FROM python:3.13

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Install reporting dependencies once at build time for stable startup.
COPY apps/api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt openpyxl python-pptx Pillow docker \
    && rm -f /tmp/requirements.txt

COPY apps/api /app/apps/api
COPY reporting_service.py /app/reporting_service.py

ENV PYTHONUNBUFFERED=1
EXPOSE 8001

CMD ["python", "reporting_service.py"]
