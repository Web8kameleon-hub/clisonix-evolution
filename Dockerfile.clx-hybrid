FROM python:3.14-bookworm

WORKDIR /app

ARG HETZNER_DEPLOY
RUN test "$HETZNER_DEPLOY" = "1" || (echo "ERROR: Hetzner-only build. Set HETZNER_DEPLOY=1." && exit 1)

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy clx package (hotguard, engines, knowledge) from source
COPY sdk/python/clx /app/clx
COPY sdist/clx-ai/clx /app/clx_extra
COPY clx_hybrid_service.py ./

RUN pip install --no-cache-dir \
    fastapi==0.111.0 \
    uvicorn[standard]==0.30.1 \
    pydantic==2.13.4 \
    httpx==0.27.0

ENV PORT=11438
ENV PYTHONUNBUFFERED=1
ENV CLX_HYBRID_API_URL=http://clisonix-api:8000
ENV CLX_HYBRID_OCEAN_URL=http://clisonix-ocean-core:8030
ENV CLX_HYBRID_CLX_AGENT_URL=http://clisonix-clx-agent:11435
ENV CLX_HYBRID_CLXI_URL=http://clisonix-clx-i:11437
ENV NODEDB_FLUID_URL=

EXPOSE 11438

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-11438}/health || exit 1

CMD ["sh", "-c", "python -m uvicorn clx_hybrid_service:app --host 0.0.0.0 --port ${PORT:-11438}"]
